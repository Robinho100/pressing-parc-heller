# Variables d'environnement requises pour la production
# Copiez ce fichier en .env et remplissez les valeurs

# Clé secrète JWT (générée automatiquement par Render)
JWT_SECRET=votre-cle-secrete-ici

# Turso (base de données cloud)
TURSO_DATABASE_URL=libsql://votre-db.turso.io
TURSO_AUTH_TOKEN=votre-token-ici

# Environnement
NODE_ENV=production
