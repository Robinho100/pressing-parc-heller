# Variables d'environnement — copiez ce fichier en .env (jamais commité) et remplissez les valeurs.
# En production, toutes ces variables doivent être définies dans le dashboard de l'hébergeur.

# --- Sécurité ---
# Clé secrète de signature des sessions admin (JWT).
# OBLIGATOIRE en production. Générez-la, par ex. :  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Compte administrateur (créé une seule fois, au premier démarrage) ---
ADMIN_EMAIL=pressingparcheller@yahoo.fr
# OBLIGATOIRE en production. À changer via « Mon compte » dès la 1re connexion, puis supprimer cette variable.
ADMIN_INITIAL_PASSWORD=

# --- Base de données Turso (cloud) ---
# Si non renseignées, un fichier SQLite local (data/pressing.db) est utilisé — pour le développement uniquement.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Environnement ---
NODE_ENV=production
